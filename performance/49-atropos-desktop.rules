// Desktop defaults for the person at the machine. Rules here are read
// before the polkit-default-privs implicit authorizations.
//
// Mount internal disks (a second SSD, a Windows partition) from Dolphin
// without the administrator password, as removable media already are.
// Only the active local session; SSH and inactive sessions still ask.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.udisks2.filesystem-mount-system" &&
        subject.local && subject.active) {
        return polkit.Result.YES;
    }
});

// Change the time zone and automatic time when travelling. Only an
// administrator (wheel) at the machine.
polkit.addRule(function(action, subject) {
    if ((action.id == "org.freedesktop.timedate1.set-timezone" ||
         action.id == "org.freedesktop.timedate1.set-ntp") &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
