#!/bin/bash
# Install the open signed G07 driver into the next snapshot, then reboot
# before the login screen, when Agama did not install it. This snapshot
# would otherwise start Plasma on llvmpipe.
set -euo pipefail

marker=/var/lib/atropos/nvidia-open-g07-installed
if [[ -e $marker ]]; then
    exit 0
fi

# Agama installs this set when atropos_nvidia is selected. A second
# transactional-update would reboot before the login screen again.
if rpm -q \
    nvidia-open-driver-G07-signed-kmp-meta \
    nvidia-open-driver-G07-signed-kmp-longterm \
    nvidia-userspace-meta-G07 \
    nvidia-video-G07 \
    nvidia-compute-utils-G07 >/dev/null 2>&1
then
    mkdir -p /var/lib/atropos
    touch "$marker"
    exit 0
fi

transactional-update --non-interactive run /usr/libexec/atropos-nvidia-apply
# /var is its own subvolume. A marker created inside the snapshot is
# hidden by that mount, so the next boot would try the install again.
mkdir -p /var/lib/atropos
touch /var/lib/atropos/nvidia-open-g07-installed
systemctl reboot
