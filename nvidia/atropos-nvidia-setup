#!/bin/bash
# Install the open signed G07 driver into the next snapshot, then reboot
# before the login screen. This snapshot has no NVIDIA module, so Plasma
# would start on llvmpipe.
set -euo pipefail

marker=/var/lib/atropos/nvidia-open-g07-installed
if [[ -e $marker ]]; then
    exit 0
fi

transactional-update --non-interactive run /usr/libexec/atropos-nvidia-apply
systemctl reboot
