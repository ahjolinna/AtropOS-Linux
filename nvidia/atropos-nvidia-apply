#!/bin/bash
# Runs inside a transactional-update snapshot.
# SDB:NVIDIA drivers, Leap and Tumbleweed: the open G07 driver is
# nvidia-open-driver-G07-signed-kmp-meta. Slowroll uses the Tumbleweed
# NVIDIA repository (openSUSE-repos-Slowroll-NVIDIA). The module has to
# match kernel-longterm. Userspace is required explicitly because
# zypp-no-recommends is installed and the meta package does not require it.
set -euo pipefail

# tukit sets this for the chroot command. Set it again so the kernel
# scriptlet defers sdbootutil until the snapshot is closed. Do not set
# it on the outer transactional-update process: that process exits
# immediately when the variable is already present.
export TRANSACTIONAL_UPDATE=1

# On the running system the EFI partition is mounted at /boot. Inside
# this snapshot that path is a directory on the root subvolume, so
# sdbootutil reports "Couldn't find EFI system partition", the kernel
# %post returns 1, and zypper exits 107. transactional-update then
# deletes the snapshot. Mount the partition from fstab first.
mount_firmware_boot() {
    local spec target
    spec=$(awk '$1 !~ /^#/ && ($2 == "/boot" || $2 == "/efi" || $2 == "/boot/efi") { print $1; exit }' /etc/fstab)
    target=$(awk '$1 !~ /^#/ && ($2 == "/boot" || $2 == "/efi" || $2 == "/boot/efi") { print $2; exit }' /etc/fstab)
    [[ -n $spec && -n $target ]] || return 0
    if findmnt --mountpoint "$target" >/dev/null 2>&1; then
        return 0
    fi
    mkdir -p -- "$target"
    mount "$spec" "$target"
}
mount_firmware_boot

zypper --non-interactive --gpg-auto-import-keys refresh
# --auto-agree-with-licenses is a command option. zypper 1.14 exits 2
# when it is placed before the subcommand, and the driver is not installed.
# 102 and 103 mean the packages were installed and a reboot is required.
# transactional-update run keeps the snapshot only when this script exits 0.
rc=0
zypper --non-interactive --gpg-auto-import-keys install --auto-agree-with-licenses \
    nvidia-open-driver-G07-signed-kmp-meta \
    nvidia-open-driver-G07-signed-kmp-longterm \
    nvidia-userspace-meta-G07 \
    nvidia-video-G07 \
    nvidia-compute-utils-G07 || rc=$?
[[ $rc -eq 0 || $rc -eq 102 || $rc -eq 103 ]]

mkdir -p /var/lib/atropos
touch /var/lib/atropos/nvidia-open-g07-installed
