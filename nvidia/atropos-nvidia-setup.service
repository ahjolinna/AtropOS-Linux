[Unit]
Description=Install the open NVIDIA G07 driver for kernel-longterm
After=network-online.target
Wants=network-online.target
Before=display-manager.service plasmalogin.service
ConditionPathExists=!/var/lib/atropos/nvidia-open-g07-installed

[Service]
Type=oneshot
ExecStart=/usr/libexec/atropos-nvidia-setup
# A stuck download must not hold the login screen forever.
TimeoutStartSec=20min

[Install]
WantedBy=multi-user.target
