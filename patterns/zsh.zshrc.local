# AtropOS interactive zsh setup. /etc/zshrc sources this when the file
# is not empty. A non-interactive shell never reads /etc/zshrc.
# Extra completions come from /usr/share/zsh/site-functions, which
# compinit already searches.

HISTSIZE=100000
SAVEHIST=100000
setopt HIST_IGNORE_ALL_DUPS
setopt SHARE_HISTORY
setopt INC_APPEND_HISTORY
# KDE Linux terminal defaults that do not replace the openSUSE prompt.
# /etc/zshrc already turns on autocd, colored ls, and the arrow-key history.
setopt auto_cd
setopt interactivecomments
setopt hist_verify
unsetopt nomatch

# Stop at / and . so Ctrl+Left walks a path one component at a time.
WORDCHARS=${WORDCHARS//[\/&.;]}
ZLE_REMOVE_SUFFIX_CHARS=$' \t\n;&|'
ZLE_SPACE_SUFFIX_CHARS=$';&|'

zstyle ':completion:*' menu no
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

# Home, End, and Delete. Konsole sends these. Page Up and Page Down stay
# on the openSUSE history search from /etc/zshrc.
bindkey '\e[1~' beginning-of-line
bindkey '\e[H'  beginning-of-line
bindkey '\eOH'  beginning-of-line
bindkey '\e[4~' end-of-line
bindkey '\e[F'  end-of-line
bindkey '\eOF'  end-of-line
bindkey '\e[3~' delete-char
bindkey '\e[2~' overwrite-mode
bindkey '^[[1;5D' backward-word
bindkey '^[[1;5C' forward-word
# Ctrl+Backspace. Plain Backspace stays ^? from /etc/zshrc.
bindkey '^H' backward-kill-word
bindkey '^[[3;5~' kill-word
# Tab completes. It does not expand a glob onto the command line.
bindkey '^I' complete-word

if [[ -r /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
    source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

# McFly replaces Ctrl-R. It prints an error when the history file is missing.
if [[ -x /usr/bin/mcfly && -z ${MCFLY_DISABLE-} ]]; then
    _atropos_hist=${HISTFILE:-${HOME-}/.zsh_history}
    if [[ -n ${HOME-} && ! -e $_atropos_hist ]]; then
        : > "$_atropos_hist" 2>/dev/null || true
    fi
    if [[ -r $_atropos_hist ]]; then
        eval "$(/usr/bin/mcfly init zsh)"
    fi
    unset _atropos_hist
fi

# Highlighting wraps the line editor, so it follows autosuggestions and
# McFly. Substring search has to follow highlighting.
if [[ -r /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
    source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

if [[ -r /usr/share/zsh-history-substring-search/zsh-history-substring-search.zsh ]]; then
    HISTORY_SUBSTRING_SEARCH_ENSURE_UNIQUE=1
    source /usr/share/zsh-history-substring-search/zsh-history-substring-search.zsh
    if [[ -n ${terminfo[kcuu1]-} ]]; then
        bindkey "${terminfo[kcuu1]}" history-substring-search-up
        bindkey "${terminfo[kcud1]}" history-substring-search-down
    fi
    bindkey '^[[A' history-substring-search-up
    bindkey '^[[B' history-substring-search-down
    bindkey '^[[1;5A' history-substring-search-up
    bindkey '^[[1;5B' history-substring-search-down
    bindkey -M emacs '^P' history-substring-search-up
    bindkey -M emacs '^N' history-substring-search-down
fi

# journalctl pages in the terminal instead of cutting the line.
export SYSTEMD_LESS=FRXMK
